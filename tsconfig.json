{
    "compilerOptions": {
      "target": "ES6",
      "module": "commonjs",
      "lib": ["ES6"],
      "experimentalDecorators": true,
      "emitDecoratorMetadata": true,
      "outDir": "./dist",
      "moduleResolution": "node",
      "strict": false,
      "resolveJsonModule": true,
      "sourceMap": true,
      "esModuleInterop": true,
      "skipLibCheck": true,
      "forceConsistentCasingInFileNames": true,
      "rootDir": "./src",
      "baseUrl": "./src",
      "paths": {
      "@/*": ["*"]
      }
    },
    "include": ["src/**/*.ts"],
    "exclude": ["node_modules"]
}



